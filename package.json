    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.50.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.125.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
