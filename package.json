{
  "name": "vodtinker-portfolio",
  "version": "1.0.0",
  "description": "Modern multilingual portfolio website built with Astro, React, and TypeScript. Features AI-powered chat assistant, dark/light theme, and responsive design.",
  "type": "module",
  "private": false,
  "author": {
    "name": "Daniel Fonov",
    "email": "danielfonov71@vodtinker.dev",
    "url": "https://github.com/VodTinker"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VodTinker/VodTinker-Webpage.git"
  },
  "homepage": "https://github.com/VodTinker/VodTinker-Webpage#readme",
  "bugs": {
    "url": "https://github.com/VodTinker/VodTinker-Webpage/issues"
  },
  "keywords": [
    "portfolio",
    "astro",
    "react",
    "typescript",
    "tailwindcss",
    "chatbot",
    "openai",
    "multilingual",
    "i18n",
    "responsive",
    "dark-mode",
    "cloudflare-pages"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --port 3000 --host 0.0.0.0",
    "build": "astro check && astro build",
    "build:clean": "rm -rf dist node_modules/.vite node_modules/.astro && npm run build",
    "lint": "bunx biome lint --write && astro check",
    "format": "bunx biome format --write",
    "preview": "astro preview --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:draft": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
