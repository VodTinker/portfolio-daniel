{
  "name": "vodtinker-portfolio",
  "version": "1.0.0",
  "description": "Modern multilingual portfolio website built with Astro, React, and TypeScript. Features AI-powered chat assistant, dark/light theme, and responsive design.",
  "type": "module",
  "private": false,
  "author": {
    "name": "Daniel Fonov",
    "email": "danielfonov71@vodtinker.dev",
    "url": "https://github.com/VodTinker"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VodTinker/VodTinker-Webpage.git"
  },
  "homepage": "https://github.com/VodTinker/VodTinker-Webpage#readme",
  "bugs": {
    "url": "https://github.com/VodTinker/VodTinker-Webpage/issues"
  },
  "keywords": [
    "portfolio",
    "astro",
    "react",
    "typescript",
    "tailwindcss",
    "chatbot",
    "openai",
    "multilingual",
    "i18n",
    "responsive",
    "dark-mode",
    "cloudflare-pages"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --port 3000 --host 0.0.0.0",
    "build": "astro check && astro build",
    "build:clean": "rm -rf dist node_modules/.vite node_modules/.astro && bun run build",
    "lint": "bunx biome lint --write && astro check",
    "format": "bunx biome format --write",
    "preview": "astro preview --port 3000",
    "deploy": "bun run build && wrangler pages deploy dist",
    "deploy:draft": "bun run build && wrangler pages deploy dist",
    "sprite": "blender -b -P blender/render_sprite.py --",
    "sprite:demo": "blender -b -P blender/render_sprite.py -- --demo server --out public/sprites/server.png"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@astrojs/tailwind": "^6.0.2",
    "@emailjs/browser": "^4.4.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@microagents/server-brave-search": "^0.0.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-brave-search": "^0.6.2",
    "@noble/hashes": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "animejs": "^4.5.0",
    "aos": "^2.3.4",
    "astro": "^6.4.8",
    "axios": "^1.19.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.34.0",
    "node-fetch": "^3.3.2",
    "nostr-tools": "^2.25.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@eslint/js": "^10.0.1",
    "@types/animejs": "^3.1.13",
    "@types/aos": "^3.0.8",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
