---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio Asir-Daniel Fonov " } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Favicon principal: WebP proporcionado por el usuario (mejor compatibilidad). -->
  <link rel="icon" type="image/webp" href="/Vodtinker-removebg-preview.webp" />
  <!-- Icono para dispositivos Apple -->
  <link rel="apple-touch-icon" href="/Vodtinker-removebg-preview.webp" />
  <!-- Fallback SVG (mantener si ya existía) -->
  <link rel="icon" type="image/svg+xml" href="/logo-option-1.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="VodTinker — Sysadmin & Web Dev" />
    <meta property="og:description" content="Portfolio de Daniel Fonov — ASIR student, Linux sysadmin & web developer from Gijón, Spain." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vodtinker.dev" />
    <meta property="og:image" content="https://vodtinker.dev/og-preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="VodTinker — Sysadmin & Web Dev" />
    <meta name="twitter:description" content="Daniel Fonov · ASIR · Linux · Web" />
    <meta name="twitter:image" content="https://vodtinker.dev/og-preview.png" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://vodtinker.dev/" />
    <meta name="author" content="Daniel Fonov" />
    <meta name="keywords" content="Daniel Fonov, VodTinker, sysadmin, ASIR, homelab, web development, Linux, Gijón, portfolio, Astro, TypeScript" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Daniel Fonov",
      "url": "https://vodtinker.dev",
      "sameAs": [
        "https://github.com/VodTinker",
        "https://linkedin.com/in/daniel-fonov"
      ],
      "jobTitle": "ASIR Student & Web Developer",
      "description": "ASIR student from Gijón bridging Linux infrastructure and modern web development.",
      "knowsAbout": ["Linux", "Sysadmin", "Docker", "Astro", "TypeScript", "Self-hosting"]
    }
    </script>
<script is:inline>
  (function() {
    try {
      var saved = localStorage.getItem('vod-tweaks');
      if (saved) {
        var t = JSON.parse(saved);
        if (t.mode) document.documentElement.dataset.mode = t.mode;
        if (t.scanlines === false) document.documentElement.dataset.scanlines = 'off';
        if (t.lang) document.documentElement.lang = t.lang;
      }
    } catch(e) {}
  })();
</script>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Pixelify+Sans:wght@400..700&family=Silkscreen:wght@400;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
